# Minimal kunitconfig for the Streaming page-table memory type prototype.
# Run with:
#   ./tools/testing/kunit/kunit.py run \
#       --kunitconfig=tools/testing/kunit/configs/streaming.config

CONFIG_KUNIT=y

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_DEV_DAX=y
CONFIG_PAT_STREAMING=y
CONFIG_PAT_STREAMING_KUNIT_TEST=y

CONFIG_DEBUG_VM=y

CONFIG_PRINTK=y
